# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Local:
DATABASE_URL="postgresql://postgres:1234@localhost:5432/signature_db?schema=public"
# Producción (Neon): el TLS se activa solo al detectar sslmode=require.
# DATABASE_URL="postgresql://usuario:clave@ep-xxx.us-east-2.aws.neon.tech/signature_db?sslmode=require"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# WhatsApp Cloud API — Meta for Developers > tu app > WhatsApp
# ---------------------------------------------------------------------------

# Paso 1 del panel: "Phone Number ID" (NO el número de teléfono).
WHATSAPP_PHONE_NUMBER_ID=

# Paso 1 del panel: "WhatsApp Business Account ID" (WABA).
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Paso 1: token temporal (24 h). Para producción, genera uno permanente con un
# usuario del sistema en Business Settings > Usuarios del sistema, con permisos
# whatsapp_business_messaging + whatsapp_business_management + business_management.
WHATSAPP_ACCESS_TOKEN=

# Cadena que TÚ inventas. Debe ser idéntica a la que pegas en
# WhatsApp > Configuración > Webhooks > "Token de verificación".
WHATSAPP_VERIFY_TOKEN=un-secreto-que-tu-inventas

# Configuración de la app > Básica > Clave secreta de la app.
# Sin esto no se puede validar que el webhook venga realmente de Meta.
WHATSAPP_APP_SECRET=

# Versión del Graph API (el curl del panel usa v25.0).
WHATSAPP_GRAPH_VERSION=v25.0

# Ponlo en false SÓLO en local si pruebas el webhook con curl/Postman.
WHATSAPP_VERIFY_SIGNATURE=true

# ---------------------------------------------------------------------------
# Datos que aparecen en /privacy y /terms (Meta exige la URL de privacidad
# para poder publicar la app).
# ---------------------------------------------------------------------------
LEGAL_BUSINESS_NAME=Aura Signature
LEGAL_CONTACT_EMAIL=
LEGAL_RETENTION_MONTHS=24

# ---------------------------------------------------------------------------
# Feed de catálogo para el Administrador de ventas de Meta
# ---------------------------------------------------------------------------
# URL pública de esta API, sin barra final. Se usa para los enlaces del feed:
# Meta exige que `link` esté en tu dominio y rastrea esa página.
PUBLIC_BASE_URL=https://signature-api-x65k.onrender.com
CATALOG_BRAND=Aura Signature
CATALOG_CURRENCY=PEN
# new | refurbished | used
CATALOG_CONDITION=new

# Opcional: protege el feed con HTTP Basic. Vacías = feed público.
# Si las llenas, pon las MISMAS en el Administrador de ventas de Meta,
# en los campos de usuario y contraseña junto a la URL del feed.
# No afecta a las páginas de producto (/p/:slug), que deben seguir públicas.
CATALOG_FEED_USER=
CATALOG_FEED_PASSWORD=
